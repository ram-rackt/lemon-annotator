# All settings are optional for local use; defaults work out of the box.

# ---- Shared / hosted setup (Supabase). Leave empty for a local, single-user Lemon. ----

# Postgres connection string. When set, projects and annotations are stored there instead of ./app_data.
# Supabase > Connect > Session pooler, e.g.
# LEMON_DATABASE_URL=postgresql://postgres.abcdefghijkl:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
LEMON_DATABASE_URL=

# Supabase project URL. When set, every request needs a signed-in user.
# LEMON_SUPABASE_URL=https://abcdefghijkl.supabase.co
LEMON_SUPABASE_URL=

# Only for older Supabase projects that sign tokens with the legacy JWT secret.
LEMON_SUPABASE_JWT_SECRET=

# Optional: only these emails may use the app (comma-separated).
LEMON_ALLOWED_EMAILS=

# ---- General ----

# Where projects, annotations and exports are stored when no database is set (relative to the repo root).
LEMON_DATA_DIR=./app_data

# Browser origins allowed to call the API directly, e.g. your Vercel site when hosted.
LEMON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host names the API answers to while sign-in is off (protects against DNS rebinding).
LEMON_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Max S3 objects scanned per listing (protects against enormous buckets).
LEMON_MAX_LIST_KEYS=50000

# AWS credentials are entered per project in the UI. If you leave the keys empty
# there, boto3 falls back to the standard chain, so these also work:
# AWS_PROFILE=my-profile
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js (frontend/.gitignore covers the frontend in detail)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Logs
*.log
npm-debug.log*


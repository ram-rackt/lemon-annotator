# Local use: where the Next.js server forwards /api/* requests (the FastAPI backend).
BACKEND_URL=http://127.0.0.1:8000

# ---- Hosted setup (Vercel). Leave empty for a local, single-user Lemon. ----

# The backend's public address (Render). The browser then calls it directly.
# NEXT_PUBLIC_API_URL=https://lemon-api.onrender.com
NEXT_PUBLIC_API_URL=

# Supabase > Project Settings > API: project URL and publishable (or anon) key. Turns on sign-in.
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijkl.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
